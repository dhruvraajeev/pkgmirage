{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pkgmirage",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // The website: files are served before the Worker runs, so the Worker only sees paths that aren't files. Only the
  // tests use the binding, to read the files the way the platform serves them.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "CACHE", "id": "2544125dc6624d68a12275e7b34929fd" }],
  "d1_databases": [{ "binding": "DB", "database_name": "pkgmirage", "database_id": "621a2450-a204-47d5-b995-f37db653f006" }],
  // Nightly re-check of watched names, off the hour. Fires only once deployed; locally: wrangler dev --test-scheduled.
  "triggers": { "crons": ["17 4 * * *"] },
  // Keys the hashes that count sightings once per caller per day; locally from .dev.vars.
  "secrets": { "required": ["SIGHTING_KEY"] },
  // Per caller, per Cloudflare location. A cold install peaked at 453 requests in 10 s; npm retries a 429 after
  // 10 s, which lands in a fresh window. The periods are repeated in src/index.ts for Retry-After.
  "ratelimits": [
    { "name": "NPM_LIMIT", "namespace_id": "1001", "simple": { "limit": 1000, "period": 10 } },
    { "name": "CHECK_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // A scan checks up to 750 names: 5 a minute is about what /api/check allows (60 x 50).
    { "name": "SCAN_LIMIT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ]
}
